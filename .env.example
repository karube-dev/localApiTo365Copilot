# -----------------------------------------------------------------
# localApiTo365Copilot – environment variables
# Copy this file to .env and adjust the values for your environment.
# -----------------------------------------------------------------

# Port the Express server listens on (default: 3000)
PORT=3000

# Full URL of the Microsoft 365 Copilot Chat page.
COPILOT_CHAT_URL=https://m365.cloud.microsoft/chat

# Milliseconds to wait for the chat page to become interactive (default: 30 000)
READY_TIMEOUT_MS=30000

# Milliseconds to wait for the assistant reply (default: 120 000)
REPLY_TIMEOUT_MS=120000

# Path where Playwright stores the persistent browser session (cookies, localStorage, …).
# A relative path is resolved from the project root.
# Default: .browser-session  (created automatically on first run)
BROWSER_USER_DATA_DIR=.browser-session

# Set to "false" to run the browser in headed mode (useful for the initial login).
# Default: true (headless)
BROWSER_HEADLESS=true
